# Model access. Copy to `.env` and fill in your key.
# Remote (OpenRouter / OpenAI-compatible):
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# none keeps structured rewrites fast; low/medium/high allow deliberation.
OPENROUTER_REASONING_EFFORT=none

# Fully local alternative (comment out the block above):
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_EMBED_MODEL=nomic-embed-text

# auto = polish when a remote provider is configured, deterministic for ollama.
# LLM_POLISH=auto
# Per-run guardrails (calls and tokens are recorded in the llm_calls table).
# LLM_MAX_CALLS=12
# LLM_MAX_TOKENS=30000
# LLM_MAX_RETRIES=2

# SEC requests should identify a real contact.
# SEC_USER_AGENT=Dossier Research (your firm) research@example.com

# ---------------------------------------------------------------- production
# development | production. Production enables JSON logs, HSTS and disables docs.
# DOSSIER_ENV=production
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Optional access control. Leave empty for the local demo. Use a long random
# token (for example `openssl rand -hex 32`).
# DOSSIER_ACCESS_TOKEN=
# Or named keys: DOSSIER_API_KEYS=analyst:key1,reviewer:key2
# DOSSIER_CORS_ORIGINS=https://dossier.example.com
# DOSSIER_RATE_LIMIT=240
# DOSSIER_RATE_BURST=60

# embedded = in-process worker (single container / local demo)
# worker   = separate `python -m dossier.cli worker` process
# DOSSIER_RUN_MODE=embedded
# DOSSIER_JOB_STALE=900
# DOSSIER_JOB_ATTEMPTS=2
